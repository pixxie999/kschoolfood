# NEIS Open API Key (실시간 급식 데이터 조회용)
# 발급처: 나이스 교육정보 개방포털 (https://open.neis.go.kr)
NEIS_API_KEY=your_neis_api_key_here

# 학교 및 교육청 코드 설정
# 예: SEOUL_OFFICE_CODE=B10, SCHOOL_CODE=7010537
OFFICE_CODE=your_office_code_here
SCHOOL_CODE=your_school_code_here

# AI Localization을 위한 API Key 설정
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 활성화할 LLM 제공자 설정 (gemini 또는 openai)
ACTIVE_LLM_PROVIDER=gemini

# 제휴 마케팅(Affiliate) 코드 설정
AMAZON_TAG=your_amazon_tag_here
IHERB_CODE=your_iherb_code_here
