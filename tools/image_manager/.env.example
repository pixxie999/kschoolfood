# Cloudflare R2
# dash.cloudflare.com → R2 → Manage R2 API Tokens 에서 확인
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kschoolfood-images
R2_PUBLIC_URL=https://images.kschoolfood.com

# Google Sheets
SHEET_ID=16oMUOCxOuSWAsGmi9KQ0b_dUfX_DYcAFJa7ToE9QHW4

# 서비스 계정 JSON — 아래 중 하나만 설정하면 됩니다
# 방법 1: 파일 경로 (로컬 JSON 파일)
GOOGLE_SA_JSON_PATH=/Users/kosangsuk/Desktop/uasoft/ua-sites/kschoolfood/tools/image_manager/service_account.json

# 방법 2: JSON 내용 직접 입력 (한 줄로)
# GOOGLE_SA_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com",...}

# 관리자 로그인
ADMIN_PASSWORD=your_admin_password

# Cloudflare D1 (저장 즉시 사이트 반영)
# dash.cloudflare.com → Workers & Pages → D1 → kschoolfood-db 에서 확인
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token   # D1:Edit 권한 필요
